# Nunca subas .env. Copia este archivo a .env solo en local.
PORT=3000
NODE_ENV=development

# En producción son obligatorios y deben ser valores aleatorios largos y distintos.
JWT_ACCESS_SECRET=cambiar-en-produccion
JWT_REFRESH_SECRET=cambiar-en-produccion

# Usuario demo opcional (solo en memoria, no toca la base de datos).
USUARIO_DEMO_NOMBRE=Demo
USUARIO_DEMO_CORREO=demo@local.test
USUARIO_DEMO_PASSWORD=clave-segura-123
USUARIO_DEMO_ROL=editor
